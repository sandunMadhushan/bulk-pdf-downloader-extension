{
  "manifest_version": 3,
  "name": "Bulk PDF Downloader",
  "version": "2.5.2",
  "description": "Bulk PDF downloader: scan a page, Google Classroom or Moodle for PDF links and download the ones you choose in one click.",
  "author": "Sandun Madhushan",
  "homepage_url": "https://github.com/sandunMadhushan/bulk-pdf-downloader-extension",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen"],
  "host_permissions": ["https://classroom.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://classroom.google.com/*"],
      "js": ["content-classroom.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
